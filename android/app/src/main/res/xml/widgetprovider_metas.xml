<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 30 min (el mínimo de Android): mueve el "hoy" al cambiar de día. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="280dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="500dp"
    android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/rn_widget"
    android:previewLayout="@layout/rn_widget"
    android:description="@string/widget_metas_descripcion"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen">
</appwidget-provider>
